{
  "expo": {
    "name": "Sana Printers",
    "slug": "sana-printers",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "sana-printers",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanaprinters.expense"
    },
    "android": {
      "package": "com.sanaprinters.expense",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fbaff96-0212-4695-9e92-d1166a67128b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sana Printers needs your photos to attach receipts to transactions.",
          "cameraPermission": "Sana Printers needs your camera to capture receipts."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/5fbaff96-0212-4695-9e92-d1166a67128b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 300
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
