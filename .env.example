# Expo / Firebase web SDK configuration (client-safe, EXPO_PUBLIC_ prefix)
# Copy this file to `.env` and fill in values from your Firebase project settings.
# The app works fully offline without these; they only enable cloud sync + PDF reports.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
